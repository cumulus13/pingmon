# Pingmon Configuration File
# Place this file in one of these locations:
# Windows:
#   - %USERPROFILE%\.pingmon\.env
#   - %APPDATA%\.pingmon\.env
# Linux/macOS:
#   - ~/.pingmon/.env
#   - ~/.config/.pingmon/.env

# Timeout threshold in seconds before sending Growl notification
# Default: 60 (1 minute)
PINGMON_TIMEOUT=60
